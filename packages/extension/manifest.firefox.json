{
  "manifest_version": 2,
  "name": "PiX",
  "short_name": "PiX",
  "description": "PiX web extension — records browser interactions as PiX interaction scores. Local-only. Exports PiX-JSON (round-trip with the PiX editor) and tutorial PDFs.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "downloads",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "PiX",
    "default_popup": "popup/index.html"
  },
  "background": {
    "scripts": ["background/index.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pix-extension@eadpucv.cl",
      "strict_min_version": "115.0"
    }
  }
}
