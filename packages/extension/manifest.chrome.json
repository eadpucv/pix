{
  "manifest_version": 3,
  "name": "PiX Recorder",
  "short_name": "PiX",
  "description": "Records browser interactions as PiX interaction scores. Local-only. Exports PiX-JSON (round-trip with the PiX editor) and tutorial PDFs.",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "PiX Recorder",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay/index.html", "overlay/index.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
